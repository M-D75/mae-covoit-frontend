VUE_APP_API_SUPABASE_URL=https://your-project-ref.supabase.co
VUE_APP_API_SUPABASE_KEY=your_publishable_or_anon_key
VUE_APP_API_STRIPE_PK=pk_test_replace_me
VUE_APP_MAP_PROVIDER=leaflet
VUE_APP_API_VUE_GOOGLE_MAP=replace_me
# Utilisé pour calculer les itinéraires avec Google, même si la carte est Leaflet.
VUE_APP_API_GOOGLE_ROUTE_API_KEY=replace_me
VUE_APP_MODE=local
VUE_APP_SERVER_LOCAL_URL=http://localhost:3001
# Facultatif : utilisez une URL de staging plutôt que la production.
VUE_APP_SERVER_ONLINE_URL=https://server-staging.example.com
# Must match MOBILE_APP_URL and the native Android/iOS configuration.
# Add ekko-vi-shimago-app://callback/auth, the local /auth/callback URL and
# the production /auth/callback URL to Supabase Auth redirect URLs.
VUE_APP_MOBILE_URL_SCHEME=ekko-vi-shimago-app
